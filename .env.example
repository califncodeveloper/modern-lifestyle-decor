# ==============================================================================
# Modern LifeStyle Decor - Environment Variables Template
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Modern LifeStyle Decor"

# Groq AI SDK Credentials
# Note: Keep GROQ_API_KEY private! Server-side ONLY - do NOT prefix with NEXT_PUBLIC_
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

